{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAndTagExactStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:TagResource"
      ],
      "Resource": "arn:aws:s3:::__STATE_BUCKET_NAME__",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageStateBucketControls",
      "Effect": "Allow",
      "Action": [
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListTagsForResource",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:UntagResource"
      ],
      "Resource": "arn:aws:s3:::__STATE_BUCKET_NAME__",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ReadAndWriteTerraformState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::__STATE_BUCKET_NAME__/bootstrap/terraform.tfstate",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageTerraformStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::__STATE_BUCKET_NAME__/bootstrap/terraform.tfstate.tflock",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageExactBootstrapBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ListTagsForResource",
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ViewBudget"
      ],
      "Resource": "arn:aws:budgets::__AWS_ACCOUNT_ID__:budget/opensearch-lab-monthly-cost",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ReadDefaultBillingViewData",
      "Effect": "Allow",
      "Action": "billing:GetBillingViewData",
      "Resource": "arn:aws:billing::__AWS_ACCOUNT_ID__:billingview/primary",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "CreateHumanRoleWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/opensearch-lab-terraform-admin",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap",
          "iam:PermissionsBoundary": "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/opensearch-lab-terraform-admin-boundary"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "CreateGitHubRoleWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/opensearch-lab-github-actions",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap",
          "iam:PermissionsBoundary": "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/opensearch-lab-github-actions-boundary"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ReadAndTagExactBootstrapRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:TagRole"
      ],
      "Resource": [
        "arn:aws:iam::__AWS_ACCOUNT_ID__:role/opensearch-lab-terraform-admin",
        "arn:aws:iam::__AWS_ACCOUNT_ID__:role/opensearch-lab-github-actions"
      ],
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageExactGitHubOIDCProvider",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:ListOpenIDConnectProviderTags",
        "iam:TagOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:oidc-provider/token.actions.githubusercontent.com",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ReadExactBootstrapUser",
      "Effect": "Allow",
      "Action": "iam:GetUser",
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
        },
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:__AWS_ACCOUNT_ID__:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    }
  ]
}
