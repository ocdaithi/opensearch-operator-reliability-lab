{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAndTagExactStateBucketPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:TagResource"
      ],
      "Resource": "arn:aws:s3:::opensearch-lab-tfstate-*",
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageStateBucketControls",
      "Effect": "Allow",
      "Action": [
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListTagsForResource",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:UntagResource"
      ],
      "Resource": "arn:aws:s3:::opensearch-lab-tfstate-*",
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ListExactTerraformStateKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::opensearch-lab-tfstate-*",
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        },
        "StringEquals": {
          "s3:prefix": [
            "bootstrap/terraform.tfstate",
            "bootstrap/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ReadAndWriteTerraformState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::opensearch-lab-tfstate-*/bootstrap/terraform.tfstate",
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageTerraformStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::opensearch-lab-tfstate-*/bootstrap/terraform.tfstate.tflock",
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageExactBootstrapBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ListTagsForResource",
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ViewBudget"
      ],
      "Resource": "arn:aws:budgets::*:budget/opensearch-lab-monthly-cost",
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ReadDefaultBillingViewData",
      "Effect": "Allow",
      "Action": "billing:GetBillingViewData",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageExactBootstrapRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:PutRolePolicy",
        "iam:TagRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/opensearch-lab-terraform-admin",
        "arn:aws:iam::*:role/opensearch-lab-github-actions"
      ],
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageExactGitHubOIDCProvider",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:ListOpenIDConnectProviderTags",
        "iam:TagOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::*:oidc-provider/token.actions.githubusercontent.com",
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    },
    {
      "Sid": "ManageBootstrapUserRolePermission",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:GetUserPolicy",
        "iam:PutUserPolicy"
      ],
      "Resource": "arn:aws:iam::*:user/opensearch-lab-bootstrap",
      "Condition": {
        "ArnLike": {
          "aws:SignInSessionArn": "arn:aws:signin:*:${aws:PrincipalAccount}:session/*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "__TEMPORARY_POLICY_EXPIRY_UTC__"
        }
      }
    }
  ]
}
