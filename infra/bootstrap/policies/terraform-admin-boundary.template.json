{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndWriteTerraformState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:__AWS_PARTITION__:s3:::__STATE_BUCKET_NAME__/bootstrap/terraform.tfstate"
    },
    {
      "Sid": "ManageTerraformStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:__AWS_PARTITION__:s3:::__STATE_BUCKET_NAME__/bootstrap/terraform.tfstate.tflock"
    },
    {
      "Sid": "ManageStateBucketControls",
      "Effect": "Allow",
      "Action": [
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListTagsForResource",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:TagResource",
        "s3:UntagResource"
      ],
      "Resource": "arn:__AWS_PARTITION__:s3:::__STATE_BUCKET_NAME__"
    },
    {
      "Sid": "ManageBootstrapBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ListTagsForResource",
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ViewBudget"
      ],
      "Resource": "arn:__AWS_PARTITION__:budgets::__AWS_ACCOUNT_ID__:budget/opensearch-lab-monthly-cost"
    },
    {
      "Sid": "ReadDefaultBillingViewData",
      "Effect": "Allow",
      "Action": "billing:GetBillingViewData",
      "Resource": "arn:__AWS_PARTITION__:billing::__AWS_ACCOUNT_ID__:billingview/primary"
    },
    {
      "Sid": "ReadExactBootstrapRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:__AWS_PARTITION__:iam::__AWS_ACCOUNT_ID__:role/opensearch-lab-terraform-admin",
        "arn:__AWS_PARTITION__:iam::__AWS_ACCOUNT_ID__:role/opensearch-lab-github-actions"
      ]
    },
    {
      "Sid": "ReadExactGitHubOIDCProvider",
      "Effect": "Allow",
      "Action": [
        "iam:GetOpenIDConnectProvider",
        "iam:ListOpenIDConnectProviderTags"
      ],
      "Resource": "arn:__AWS_PARTITION__:iam::__AWS_ACCOUNT_ID__:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "AuditExactBootstrapUser",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:ListAccessKeys",
        "iam:ListAttachedUserPolicies",
        "iam:ListGroupsForUser",
        "iam:ListMFADevices",
        "iam:ListUserPolicies"
      ],
      "Resource": "arn:__AWS_PARTITION__:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap"
    },
    {
      "Sid": "ReadExactPermissionsBoundaries",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": [
        "arn:__AWS_PARTITION__:iam::__AWS_ACCOUNT_ID__:policy/opensearch-lab-terraform-admin-boundary",
        "arn:__AWS_PARTITION__:iam::__AWS_ACCOUNT_ID__:policy/opensearch-lab-github-actions-boundary"
      ]
    },
    {
      "Sid": "DetachReviewedTemporaryBootstrapPolicy",
      "Effect": "Allow",
      "Action": "iam:DetachUserPolicy",
      "Resource": "arn:__AWS_PARTITION__:iam::__AWS_ACCOUNT_ID__:user/opensearch-lab-bootstrap",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:__AWS_PARTITION__:iam::__AWS_ACCOUNT_ID__:policy/opensearch-lab-temporary-bootstrap"
        }
      }
    },
    {
      "Sid": "DeleteReviewedTemporaryBootstrapPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListEntitiesForPolicy"
      ],
      "Resource": "arn:__AWS_PARTITION__:iam::__AWS_ACCOUNT_ID__:policy/opensearch-lab-temporary-bootstrap"
    }
  ]
}
